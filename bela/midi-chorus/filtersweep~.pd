#N canvas 0 0 900 700 12;
#X obj 50 30 inlet~;
#X obj 150 30 inlet~;
#X obj 50 650 outlet~;
#X obj 150 650 outlet~;
#X text 250 10 Filter Sweep - resonant bandpass "wah";
#X text 250 30 Center freq sweeps minFreq..4000Hz as mix rises;
#X obj 350 80 r filtersweep-param;
#X obj 350 100 pack 0 30;
#X obj 350 120 line~;
#X obj 350 140 *~ 1300;
#X obj 350 160 +~ 200;
#X text 450 80 Min freq 200-1500Hz (knob2);
#X obj 350 220 r filtersweep-mix;
#X obj 350 240 pack 0 30;
#X obj 350 260 line~;
#X text 450 220 Wet/dry mix (EEG);
#X obj 350 300 expr~ $v1+$v2*(4000-$v1);
#X text 450 300 Center = minFreq + mix*(4000-minFreq);
#X obj 50 360 vcf~ 4;
#X obj 150 360 vcf~ 4;
#X text 250 360 Bandpass filters\, Q=4;
#X obj 50 420 *~;
#X obj 150 420 *~;
#X obj 350 440 *~ -1;
#X obj 350 460 +~ 1;
#X text 450 440 Dry amount;
#X obj 50 480 *~;
#X obj 150 480 *~;
#X obj 50 540 +~;
#X obj 150 540 +~;
