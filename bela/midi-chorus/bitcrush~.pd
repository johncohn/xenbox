#N canvas 0 0 900 700 12;
#X obj 50 30 inlet~;
#X obj 150 30 inlet~;
#X obj 50 650 outlet~;
#X obj 150 650 outlet~;
#X text 250 10 Bitcrusher - amplitude quantization\, lo-fi/gritty;
#X text 250 30 Rounds signal to N discrete levels;
#X obj 350 80 r bitcrush-param;
#X obj 350 100 pack 0 30;
#X obj 350 120 line~;
#X obj 350 140 *~ -60;
#X obj 350 160 +~ 64;
#X text 450 80 Steps N: 4(coarse)..64(subtle);
#X obj 50 220 expr~ floor($v1*$v2+0.5)/$v2;
#X obj 150 220 expr~ floor($v1*$v2+0.5)/$v2;
#X text 250 220 Quantize: round(x*N)/N;
#X obj 350 280 r bitcrush-mix;
#X obj 350 300 pack 0 30;
#X obj 350 320 line~;
#X obj 350 360 *~ -1;
#X obj 350 380 +~ 1;
#X text 450 280 Wet/dry mix (EEG);
#X obj 50 420 *~;
#X obj 150 420 *~;
#X obj 50 460 *~;
#X obj 150 460 *~;
#X obj 50 520 +~;
#X obj 150 520 +~;
