#N canvas 0 0 900 700 12;
#X obj 50 30 inlet~;
#X obj 150 30 inlet~;
#X obj 50 650 outlet~;
#X obj 150 650 outlet~;
#X text 250 10 Auto-Panner - LFO-driven stereo movement;
#X text 250 30 Sums L+R to mono \, then pans across L/R via LFO;
#X obj 350 80 r autopan-rate;
#X obj 350 100 pack 0 30;
#X obj 350 120 line~;
#X text 450 80 Pan rate (Hz);
#X obj 350 160 osc~;
#X obj 350 200 *~ 0.5;
#X obj 350 220 +~ 0.5;
#X text 450 160 Pan position 0-1 (=right gain);
#X obj 350 260 *~ -1;
#X obj 350 280 +~ 1;
#X text 450 260 Left gain = 1-pan;
#X obj 50 100 +~;
#X obj 50 120 *~ 0.5;
#X text 250 100 Mono sum of input;
#X obj 50 320 *~;
#X obj 150 320 *~;
#X text 250 320 Wet L/R = mono * pan gains;
#X obj 350 340 r autopan-mix;
#X obj 350 360 pack 0 30;
#X obj 350 380 line~;
#X text 450 340 Wet/dry mix (EEG);
#X obj 350 420 *~ -1;
#X obj 350 440 +~ 1;
#X text 450 420 Dry amount;
#X obj 50 380 *~;
#X obj 150 380 *~;
#X obj 50 420 *~;
#X obj 150 420 *~;
#X obj 50 480 +~;
#X obj 150 480 +~;
