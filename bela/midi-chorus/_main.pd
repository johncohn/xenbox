#X obj 900 720 *~;
#X obj 900 750 *~;
#X text 950 660 tone * toneGain (feeds both L\, R);
#X text 950 690 adc ch1 * liveGain (L);
#X text 950 720 adc ch2 * liveGain (R);
#X text 950 750 sample * sampleGain (feeds both L\, R);
#X obj 900 790 +~;
#X obj 900 820 +~;
#X obj 900 850 +~;
#X obj 900 880 +~;
#X text 950 790 L partial = tone + live-L;
#X text 950 820 R partial = tone + live-R;
#X text 950 850 L final = L partial + sample;
#X text 950 880 R final = R partial + sample;
